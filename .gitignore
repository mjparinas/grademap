# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite database (dev)
/data/
/e2e-shots/

# Android signing keys and build output (docs/ANDROID.md)
*.keystore
*.jks
/android/app/
/android/build/
/android/.gradle/
/android/*.aab
/android/*.apk

# Piper read-aloud files, written by scripts/fetch-piper.mjs
/public/piper/
